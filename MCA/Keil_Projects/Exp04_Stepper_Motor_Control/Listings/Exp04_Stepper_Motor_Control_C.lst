   9          #define MOTOR_PORT P2
  10          
  11          // 4-step sequence (Full-step mode): Coil A, B, C, D
  12          unsigned char code step_cw[4]  = {0x09, 0x0C, 0x06, 0x03}; // Clockwise: 1001, 1100, 0110, 0011
  13          unsigned char code step_ccw[4] = {0x03, 0x06, 0x0C, 0x09}; // Counter-Clockwise
  14          
  15          // Software delay using 8051 Timer 0
  16          void timer0_delay(unsigned int count) {
  17   1          while (count--) {
  18   2              TMOD = (TMOD & 0xF0) | 0x01; // Timer 0, Mode 1 (16-bit timer)
  19   2              TL0 = 0x00;
  20   2              TH0 = 0xDC;                  // Delay approx 10 ms at 11.0592 MHz
  21   2              TR0 = 1;                     // Start Timer 0
  22   2              while (TF0 == 0);            // Wait for overflow
  23   2              TR0 = 0;                     // Stop Timer 0
  24   2              TF0 = 0;                     // Clear overflow flag
  25   2          }
  26   1      }
  27          
  28          void rotate_clockwise(unsigned int rotations) {
  29   1          unsigned int i;
  30   1          unsigned char s;
  31   1          for (i = 0; i < rotations * 48; i++) { // approx 48 full steps per revolution
  32   2              for (s = 0; s < 4; s++) {
  33   3                  MOTOR_PORT = (MOTOR_PORT & 0xF0) | step_cw[s];
  34   3                  timer0_delay(2); // 20 ms step delay
  35   3              }
  36   2          }
  37   1      }
  38          
  39          void rotate_counter_clockwise(unsigned int rotations) {
  40   1          unsigned int i;
  41   1          unsigned char s;
  42   1          for (i = 0; i < rotations * 48; i++) {
  43   2              for (s = 0; s < 4; s++) {
  44   3                  MOTOR_PORT = (MOTOR_PORT & 0xF0) | step_ccw[s];
  45   3                  timer0_delay(2);
  46   3              }
  47   2          }
  48   1      }
  49          
