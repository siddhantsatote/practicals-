   1          /*
   2           * Experiment 04: Stepper Motor Interfacing with 8051 using Timer Delay
   3           * Motor connected to Port 2 (P2.0 - P2.3) via ULN2003 / L293D driver IC
   4           * Supports Clockwise, Counter-Clockwise, and Speed control via Timer
   5           */
   6          
   7          #include <reg51.h>
