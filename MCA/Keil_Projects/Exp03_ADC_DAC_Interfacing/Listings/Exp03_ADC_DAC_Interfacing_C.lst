   1          /*
   2           * Experiment 03: Interfacing 8051 with ADC0804 and DAC0808
   3           * ADC: Analog Input connected to ADC0804, Digital Data read on Port 1
   4           * DAC: Digital Data output from Port 2 to DAC0808 to generate analog waveforms
   5           */
   6          
   7          #include <reg51.h>
   8          
   9          // ADC Control Pins
  10          sbit ADC_RD   = P3^7;
  11          sbit ADC_WR   = P3^6;
  12          sbit ADC_INTR = P3^2;
  13          
  14          // DAC Port
  15          #define DAC_DATA P2
  16          
  17          void delay_short(unsigned int t) {
  18   1          while (t--);
  19   1      }
  20          
  21          // Read digital value from ADC0804
  22          unsigned char read_adc(void) {
  23   1          unsigned char val;
  24   1          P1 = 0xFF;         // Configure P1 as input port
  25   1      
  26   1          // Start Conversion (Pulse WR low then high)
  27   1          ADC_WR = 0;
  28   1          delay_short(2);
  29   1          ADC_WR = 1;
  30   1      
  31   1          // Wait for End of Conversion (INTR goes low)
  32   1          while (ADC_INTR == 1);
  33   1      
  34   1          // Read Digital Value (Pulse RD low)
  35   1          ADC_RD = 0;
  36   1          val = P1;
  37   1          ADC_RD = 1;
  38   1      
  39   1          return val;
  40   1      }
  41          
  42          // Generate Sawtooth / Ramp Wave on DAC
  43          void generate_ramp(void) {
  44   1          unsigned char val;
  45   1          for (val = 0; val < 255; val++) {
  46   2              DAC_DATA = val;
  47   2              delay_short(10);
  48   2          }
  49   1      }
  50          
  51          // Generate Square Wave on DAC
  52          void generate_square(void) {
C51 COMPILER V9.60.7.0   MAIN                                                              11/04/2026 18:14:49 PAGE 2   

  53   1          DAC_DATA = 0x00;
  54   1          delay_short(500);
  55   1          DAC_DATA = 0xFF;
  56   1          delay_short(500);
  57   1      }
  58          
  59          // Generate Triangular Wave on DAC
  60          void generate_triangular(void) {
  61   1          unsigned char val;
  62   1          for (val = 0; val < 255; val++) {
  63   2              DAC_DATA = val;
  64   2              delay_short(5);
  65   2          }
  66   1          for (val = 255; val > 0; val--) {
  67   2              DAC_DATA = val;
  68   2              delay_short(5);
  69   2          }
  70   1      }
  71          
  72          void main(void) {
  73   1          unsigned char adc_value;
  74   1      
  75   1          while (1) {
  76   2              // 1. Read Analog channel from ADC
  77   2              adc_value = read_adc();
  78   2      
  79   2              // 2. Output to DAC or generate waveform
  80   2              generate_triangular();
  81   2          }
  82   1      }


