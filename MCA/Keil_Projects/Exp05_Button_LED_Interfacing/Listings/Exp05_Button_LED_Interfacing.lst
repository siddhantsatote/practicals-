                       4     
0000                   5     ORG 0000H
                       6     
0000 D2B2              7         SETB P3.2           ; Make P3.2 input for push button
0002 7590FF            8         MOV P1, #0FFH       ; Turn off all LEDs
                       9     
0005                  10     MONITOR:
0005 30B20C           11         JNB P3.2, BTN_PRESS ; If button is pressed (LOW), jump to BTN_PRESS
