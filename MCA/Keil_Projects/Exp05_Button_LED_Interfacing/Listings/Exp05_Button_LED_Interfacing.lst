000B 1120             13         ACALL DELAY
000D 759055           14         MOV P1, #55H        ; Pattern 2: alternate LEDs
0010 1120             15         ACALL DELAY
0012 80F1             16         SJMP MONITOR
                      17     
0014                  18     BTN_PRESS:
0014 759000           19         MOV P1, #00H        ; All LEDs ON
0017 1120             20         ACALL DELAY
0019 7590FF           21         MOV P1, #0FFH       ; All LEDs OFF
001C 1120             22         ACALL DELAY
001E 80E5             23         SJMP MONITOR
                      24     
0020                  25     DELAY:
0020 7AC8             26         MOV R2, #200
0022 7BFA             27     D1: MOV R3, #250
0024 DBFE             28     D2: DJNZ R3, D2
0026 DAFA             29         DJNZ R2, D1
0028 22               30         RET
                      31     
                      32     END
