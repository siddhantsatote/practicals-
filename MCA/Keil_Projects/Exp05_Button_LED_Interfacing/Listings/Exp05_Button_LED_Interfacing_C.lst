   1          /*
   2           * Experiment 05: Interfacing Push Button and 8 LEDs to 8051
   3           * 8 LEDs connected to Port 1 (P1.0 - P1.7) via 280 ohm resistors
   4           * Push Button connected to Port 3.2 (P3.2) with pull-up resistor
   5           * Demonstrates: Button debounce, LED toggle, Blinking, and Chaser patterns
   6           */
   7          
   8          #include <reg51.h>
   9          
  10          #define LED_PORT P1
  11          sbit BUTTON = P3^2;
  12          
  13          void delay_ms(unsigned int ms) {
  14   1          unsigned int i, j;
  15   1          for (i = 0; i < ms; i++)
  16   1              for (j = 0; j < 120; j++);
  17   1      }
  18          
  19          // Running Chaser Pattern
  20          void led_chaser(void) {
  21   1          unsigned char pattern = 0x01;
  22   1          unsigned char i;
  23   1          for (i = 0; i < 8; i++) {
  24   2              LED_PORT = ~pattern; // Active-low LED display
  25   2              delay_ms(100);
  26   2              pattern <<= 1;
  27   2          }
  28   1      }
  29          
  30          // All LEDs Blinking
  31          void led_blink_all(void) {
  32   1          LED_PORT = 0x00; // All LEDs ON
  33   1          delay_ms(300);
  34   1          LED_PORT = 0xFF; // All LEDs OFF
  35   1          delay_ms(300);
  36   1      }
  37          
  38          void main(void) {
  39   1          BUTTON = 1;        // Configure P3.2 as input
  40   1          LED_PORT = 0xFF;   // Turn all LEDs off
  41   1      
  42   1          while (1) {
  43   2              if (BUTTON == 0) { // Button pressed (Active Low)
  44   3                  delay_ms(20);  // Debounce delay
  45   3                  if (BUTTON == 0) {
  46   4                      // Perform Chaser pattern when pressed
  47   4                      led_chaser();
  48   4                      while (BUTTON == 0); // Wait for button release
  49   4                      delay_ms(20);
  50   4                  }
  51   3              } else {
  52   3                  // Idle: Periodic blink
